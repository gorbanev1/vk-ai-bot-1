VK_TOKEN=
VK_GROUP_ID=233007447

# Telegram Bot API. Создай бота через @BotFather и вставь токен.
# Если токен пустой, Telegram-часть не запускается, VK продолжает работать.
TELEGRAM_BOT_TOKEN=
# Твой обычный числовой Telegram user_id. Нужен для полного списка помощи,
# безлимитного режима и служебных команд владельца в ЛС Telegram.
# Узнать его можно командой /id после запуска бота.
TELEGRAM_OWNER_USER_ID=


# GigaChat необязателен. Он вызывается только командами с явным словом «гигачат».
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=
GIGACHAT_IMAGE_MODEL=GigaChat-2-Pro

DOSSIER_PASSWORD=1234
BOT_TIMEZONE=Europe/Moscow
DOSSIER_BACKFILL_DAYS=7

# Источники афиши. Формат: источник:число_постов_при_первом_проходе.
TELEGRAM_HTML_ENABLED=1
TELEGRAM_HTML_SOURCES=kurazhcity:35
# Интервал не используется: автозапуск отключён, источник запускается вручную.
TELEGRAM_HTML_INTERVAL_HOURS=24
TELEGRAM_HTML_DOWNLOAD_IMAGES=1

VK_PUBLIC_SCRAPER_ENABLED=1
VK_PUBLIC_SOURCES=rb_diesel:20,overlockbar:20
# Интервал не используется: автозапуск отключён, источник запускается вручную.
VK_PUBLIC_INTERVAL_HOURS=24
VK_PUBLIC_DOWNLOAD_IMAGES=1

# Ручная проверка событий в трёх VK-беседах. Каждая запись:
# название|ссылка|резервный лимит; записи разделяются ;
VK_CHAT_EVENT_SCRAPER_ENABLED=1
# При запуске бота беседы никогда не открываются и не сканируются.
# Пример ручного запуска: «Гигорейв парсер запустить chat:2000000022».
VK_CHAT_EVENT_CONVERSATIONS=Беседа 22|https://vk.ru/im/convo/2000000022|300;Беседа 3|https://vk.ru/im/convo/2000000003|300;Беседа 14|https://vk.ru/im/convo/2000000014|300
# Сохранено для совместимости; автоматический интервал не запускается.
VK_CHAT_EVENT_INTERVAL_HOURS=1
# После ручной команды вкладки остаются открыты. При ручной прокрутке
# видимые сообщения считываются каждые 500 мс и анализируются GPT.
VK_CHAT_LIVE_MONITOR_ENABLED=1
VK_CHAT_LIVE_POLL_MS=500
# Минимальная пауза после завершения первичного прохода; вкладка после неё не закрывается.
VK_CHAT_POST_SCAN_HOLD_SECONDS=30

# 0 = видимое окно Chromium для первого входа VK, 1 = фоновый режим.
SCRAPER_BROWSER_HEADLESS=0
# Необязательно: полный путь к установленному Chrome/Chromium/Edge.
# Если пусто, бот ищет распространённые пути автоматически.
SCRAPER_BROWSER_EXECUTABLE_PATH=

# OpenAI-совместимый GPT router
OPENAI_COMPAT_BASE_URL=https://router.cheap/v1
OPENAI_COMPAT_API_KEY=
# 1 = получать ответы GPT и генерацию изображений потоком SSE.
OPENAI_COMPAT_STREAM=1

# Отдельные прямые ключи для owner-команд диагностики API.
# Не заменяют OPENAI_COMPAT_API_KEY и не используются обычными ответами бота.
# Никогда не отправляйте ключи в чат; храните их только в .env.
OPENAI_DIRECT_API_KEY=
OPENAI_DIRECT_BASE_URL=https://api.openai.com/v1
# Необязательно: модель для команды «Гигорейв api openai тест» без явного model id.
OPENAI_DIRECT_MODEL=

# Вставьте личный ключ NVIDIA NIM только в корневой файл .env, не сюда.
# Формат значения обычно начинается с nvapi-.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Необязательно: точный model id для диагностических команд без явного селектора.
# Если пусто, «api nvidia тест» выберет вероятную chat/instruct-модель автоматически.
NVIDIA_MODEL_DEFAULT=

# NVIDIA Visual API использует тот же NVIDIA_API_KEY, но отдельный облачный endpoint.
# Оставьте model=auto, чтобы бот сам перебирал доступные image-модели.
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_IMAGE_MODEL=auto
NVIDIA_IMAGE_ATTEMPT_TIMEOUT_MS=360000
NVIDIA_IMAGE_TOTAL_TIMEOUT_MS=1200000

# Официальный Google Maps Geocoding API. Используется, когда GPT
# нашёл название места, но не вернул координаты. Нужен включённый Geocoding API.
GOOGLE_MAPS_API_KEY=

# Рабочие model id router.cheap уже указаны. Их можно переопределить через .env.
# DEFAULT — самая дешёвая базовая модель; GPT54/GPT55 — промежуточные;
# PRO/PRO2/PRO3 — Luna/Terra/Sol.
# Не используйте gpt-image, DALL-E, Sora, audio/realtime/tts-модели.
GPT_MODEL_DEFAULT=gpt-5.4-mini
GPT_MODEL_GPT54=gpt-5.4
GPT_MODEL_GPT55=gpt-5.5
GPT_MODEL_PRO=gpt-5.6-luna
GPT_MODEL_PRO2=gpt-5.6-terra
GPT_MODEL_PRO3=gpt-5.6-sol

# Анализ входящих изображений использует те же GPT_MODEL_*.
# Без ключа модель начинается с GPT_MODEL_DEFAULT, затем при двух отказах
# последовательно повышается: gpt54 -> gpt55 -> Luna -> Terra -> Sol.
# Отдельные GPT_VISION_MODE/GPT_VISION_MODEL больше не нужны.

# Отдельная модель изображений для команд «gpt картинка» и
# «gpt резюмируй картинкой». Точный id возьми из «Гигорейв gpt модели».
GPT_IMAGE_MODEL=gpt-image-2
GPT_DEFAULT_DAILY_LIMIT=20
GPT_54_DAILY_LIMIT=10
GPT_55_DAILY_LIMIT=6
GPT_IMAGE_DAILY_LIMIT=5

# Swiss Ephemeris для максимального локального расчёта джйотиш-прашны и натала.
# Если путь пуст, движок явно использует встроенную Moshier ephemeris и помечает
# расчёт как moshier-or-mixed-fallback. Для файлов Swiss укажи папку, где реально лежат *.se1.
EPHEMERIS_PATH=

# 1 = запретить скрытый fallback на Moshier. Если EPHEMERIS_PATH не настроен или
# в папке нет *.se1, локальный натал/прашна завершится понятной ошибкой.
ASTROLOGY_REQUIRE_SWISS_FILES=0

# mini/gpt54/gpt55 считают натал и прашну локально максимальным пакетом.
# pro/pro2/pro3 без ключа считают внутри модели; ключи «локалэфемериды», «локал»
# или «расчёт локально» принудительно включают тот же maximum-пакет и для pro.
# Пакет не использует сокращённые fast/balanced/full профили: в модель передаются
# все реально рассчитанные поля плюс аудит покрытия и список недоступных опций.

# 1 = дополнительно сериализовать огромный полный JSON для отладки. По умолчанию 0 ради скорости.
PRASHNA_KEEP_FULL_JSON=0

# Личные сообщения обрабатываются без слова «Гигорейв».
# Их содержимое не сохраняется в SQLite и не выводится в консоль.
# Короткий контекст ЛС хранится только в RAM до перезапуска процесса.

# Обычные вопросы в ЛС автоматически используют GPT_MODEL_DEFAULT.
# При первом сообщении и затем раз в случайный срок 1–7 дней бот предупреждает,
# что отвечает искусственный интеллект. В базе хранится только user_id и время показа.
