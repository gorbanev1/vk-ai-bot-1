# Gigorave V123 — safe configuration template (NO REAL SECRETS)
VK_TOKEN=
VK_GROUP_ID=
VK_EVENT_TOKEN=
VK_EVENT_GROUP_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
# Optional Local Bot API Server. The public Telegram cloud API limits getFile
# downloads to 20 MB; a local server removes that download limit.
TELEGRAM_BOT_API_BASE_URL=
TELEGRAM_BOT_FILE_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_STREAM=1
# Voice recognition requires an audio model; text GPT chat models cannot listen.
VOICE_TRANSCRIPTION_ENABLED=1
VOICE_TRANSCRIPTION_TIMEOUT_MS=45000
AUDIO_TRANSCRIPTION_API_KEY=
AUDIO_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
AUDIO_TRANSCRIPTION_MODELS=gpt-transcribe,gpt-4o-mini-transcribe
OPENAI_COMPAT_AUDIO_MODELS=gpt-transcribe,gpt-4o-mini-transcribe
GROQ_AUDIO_MODELS=whisper-large-v3-turbo,whisper-large-v3
GIGACHAT_CREDENTIALS=
BOT_TIMEZONE=Europe/Moscow

# Optional mobile calendar import endpoint. Upload hosting/calendar.php to your
# HTTPS shared host, set this URL to its public address, and use the exact same
# random secret in the host's EVENT_CALENDAR_HMAC_SECRET environment variable.
EVENT_CALENDAR_ENDPOINT=
EVENT_CALENDAR_HMAC_SECRET=

# Telegram Mini App Pinball
TELEGRAM_PINBALL_WEBAPP_URL=
PINBALL_HTTP_ENABLED=1
PINBALL_HTTP_HOST=127.0.0.1
PINBALL_HTTP_PORT=8787
PINBALL_INITDATA_MAX_AGE_SEC=86400

# AI audit bounded concurrency
AI_AUDIT_KEY_CONCURRENCY=8
AI_AUDIT_MODEL_CONCURRENCY=6
AI_AUDIT_PER_KEY_MODEL_CONCURRENCY=1
AI_AUDIT_REASONING_CONCURRENCY=2
AI_AUDIT_IMAGE_CONCURRENCY=4
AI_AUDIT_PER_KEY_IMAGE_CONCURRENCY=1

# Foreign/provider keys audited by owner command (add numbered variants as needed)
OPENAI_API_KEY_1=
ANTHROPIC_API_KEY_1=
GEMINI_API_KEY_1=
GROQ_API_KEY_1=
HUGGINGFACE_API_KEY_1=
NVIDIA_API_KEY_1=
