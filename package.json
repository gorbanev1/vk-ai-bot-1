    "test:natal-routing": "node tests/astrology/natalRouting.test.mjs",
    "test:communication-style": "node tests/personality/communicationStyleRouting.test.mjs",
    "test:communication-style-db": "node tests/personality/communicationStyleDatabase.test.mjs",
    "test:event-validation": "node tests/events/eventValidation.test.mjs",
    "test:banter": "node tests/personality/banterRouting.test.mjs",
