    "test:shared-commands": "node tests/shared/sharedCommands.test.mjs",
    "test:shared-date": "node tests/shared/sharedDate.test.mjs",
    "test:event-range": "node tests/events/publicEventRange.test.mjs",
    "test:source-config": "node tests/scrapers/sourceConfiguration.test.mjs",
